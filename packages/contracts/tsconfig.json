{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"moduleResolution": "node",
		"strict": true,
		"useUnknownInCatchVariables": true,
		"declaration": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"outDir": "dist"
	},
	"include": ["src/**/*.ts"]
}
